{
  "$schema": "https://picaudio.org/schemas/theme-v1.json",
  "meta": {
    "id": "dark-studio",
    "name": "Dark Studio",
    "author": "PicAudio",
    "version": "1.0.0",
    "apiVersion": "0.1-unstable",
    "description": "Default professional dark studio theme engineered for deep listening"
  },
  "colors": {
    "background": "#000000",
    "surface": "#0d0d0d",
    "surfaceElevated": "#171717",
    "panelBorder": "#262626",
    "accent": "#ffffff",
    "accentHover": "#e5e5e5",
    "textPrimary": "#ffffff",
    "textSecondary": "#a3a3a3",
    "textMuted": "#737373",
    "selection": "#262626",
    "error": "#ef4444",
    "warning": "#f59e0b",
    "success": "#22c55e"
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontSizeSmall": 9,
    "fontSizeBase": 11,
    "fontSizeLarge": 14,
    "fontSizeTitle": 18,
    "fontWeightScale": 1.0,
    "lineHeightScale": 1.2
  },
  "metrics": {
    "spacingSmall": 4,
    "spacingMedium": 8,
    "spacingLarge": 16,
    "cornerRadiusSmall": 2,
    "cornerRadiusMedium": 4,
    "panelPadding": 10
  }
}
